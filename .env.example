# Copy this file to .env. Never commit real credentials.

# Local development defaults: Docker is not required.
DATABASE_URL=sqlite:///meetasr.db
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/media

# Nếu dùng PostgreSQL qua docker-compose, khai báo các biến dưới đây
# và thay DATABASE_URL bằng:
# DATABASE_URL=postgresql://admin:password123@localhost:5432/meetasr_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=meetasr_db

# MinIO Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_BUCKET=meetasr-audio

# LLM summarization — Groq API keys
# Cách 1 (khuyến nghị): nhiều key, hệ thống tự xoay vòng khi 1 key bị rate limit
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# Cách 2: 1 key duy nhất
GROQ_API_KEY=

# Optional: avoids anonymous Hugging Face download rate limits
HF_TOKEN=

# Backend JWT. For the current local NextAuth sync flow, use the same value as
# NEXTAUTH_SECRET in frontend-next/.env.local.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_DAYS=30

# CORS — domain nào được phép gọi backend (phân cách bằng dấu phẩy)
# Local dev: để trống → mở hết  |  Production: điền domain frontend thật
# Ví dụ: ALLOWED_ORIGINS=https://app.meetingmind.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
