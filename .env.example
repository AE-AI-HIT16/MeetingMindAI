# Copy this file to .env. Never commit real credentials.

# RunPod Model Server Configuration
# Local dev default: http://localhost:8001 (production URL provided by RunPod)
RUNPOD_URL=http://localhost:8001
RUNPOD_API_KEY=your-runpod-bearer-token

# Local development defaults: Docker is not required.
DATABASE_URL=sqlite:///meetasr.db
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/media

# Nếu dùng PostgreSQL qua docker-compose:
# DATABASE_URL=postgresql://admin:password123@localhost:5432/meetasr_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=meetasr_db

# MinIO Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_BUCKET=meetasr-audio

# LLM summarization
GROQ_API_KEY=

# Cloudflare R2 Storage (S3-compatible alternative)
# STORAGE_BACKEND=s3
# MINIO_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# MINIO_ROOT_USER=<r2_access_key_id>
# MINIO_ROOT_PASSWORD=<r2_secret_access_key>
# MINIO_BUCKET=meetasr-audio

# Optional: avoids anonymous Hugging Face download rate limits
HF_TOKEN=

# Backend JWT. For NextAuth sync flow, use the same value as NEXTAUTH_SECRET.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_DAYS=30
